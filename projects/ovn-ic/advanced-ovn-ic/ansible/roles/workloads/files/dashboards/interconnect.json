{
  "title": "OVN-IC \u00b7 Interconnect",
  "uid": "ovnic-interconnect",
  "tags": [
    "ovn-ic"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Transit switches",
      "description": "Both ts-client and ts-mgmt propagated into this AZ's NB.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ovn_transit_switches_ok",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "IC gateways registered",
      "description": "Both chassis registered in IC-SB.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ovn_ic_gateways_ok",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "GENEVE tunnel",
      "description": "Tunnel to the peer chassis is present in OVS.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ovn_geneve_tunnel_up",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "RAFT members alive",
      "description": "Live members of the IC database cluster (3 = healthy, 2 = degraded but quorate).",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ovn_ic_raft_members_alive",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Interconnect traffic \u2014 GENEVE tunnel (bytes/s)",
      "description": "Every byte here crossed between the two AZs inside a GENEVE tunnel. This is the interconnect's real load.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{device=\"genev_sys_6081\"}[1m])",
          "legendFormat": "{{az}} rx",
          "refId": "A"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{device=\"genev_sys_6081\"}[1m])",
          "legendFormat": "{{az}} tx",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Routes learned per plane",
      "description": "1 = this plane's router learned the peer AZ's subnet and NO route from the other plane.",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ovn_plane_routes_ok",
          "legendFormat": "{{az}} \u00b7 {{plane}} plane",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Probe latency (control-plane checks)",
      "description": "How long each OVN control-plane check takes to answer.",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "ovn_probe_duration_seconds",
          "legendFormat": "{{az}} {{check}}",
          "refId": "A"
        }
      ]
    }
  ]
}